# Copy this file to .env and fill in your own values. Never commit .env

PORT=5000

# Free tier: https://www.mongodb.com/cloud/atlas/register
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cloudvault

# Any long random string
JWT_SECRET=change_this_to_a_long_random_secret

JWT_EXPIRES_IN=7d

# Per-user storage limit in bytes (default 10 GB)
STORAGE_LIMIT_BYTES=10737418240

# ---- Optional: only needed if/when you move from local disk storage to AWS S3 ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=
